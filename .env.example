# mock = runs offline with a rule-based planner (for dev/tests); api = real hosted <=8B endpoint
LLM_MODE=mock
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=changeme
LLM_MODEL=llama-3.1-8b-instruct
# LLM_CA_CERT=/path/to/vm05-ca.crt

EMBED_BASE_URL=http://localhost:8001/v1
EMBED_API_KEY=changeme
EMBED_MODEL=bge-small-en-v1.5
# EMBED_CA_CERT=/path/to/vm02-ca.crt

JSON_MODE=true            # set false if the endpoint has no response_format support
PLANNER_STRATEGY=structured   # structured | cot | decomposition
RERANKER=none             # or a cross-encoder name e.g. BAAI/bge-reranker-base
RATE_LIMIT=20/minute
MAX_STEPS=10
TOKEN_BUDGET=8000
CHUNK_SIZE=150
CHUNK_OVERLAP=20

# OpenTelemetry OTLP export -> Local Self-Hosted Langfuse (Zero-Touch Pre-Provisioned)
